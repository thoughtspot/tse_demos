  {
   "db": "LINE_COUNT",
   "name": "Service Lines",
   "type": "MEASURE",
   "agg": "SUM",
   "desc": "Number of service lines booked.",
   "synonyms": [
    "appointments",
    "bookings",
    "lines"
   ]
  }
 ],
 "formulas": [
  {
   "name": "Rebook Rate",
   "desc": "Share of completed services where the patient booked the next visit before leaving.",
   "format": "0.0%",
   "expr": "sum ( [{T}::REBOOKED_FLAG] ) / sum ( [{T}::COMPLETED_FLAG] )"
  },
  {
   "name": "No-show Rate",
   "desc": "Share of booked service lines that were no-shows.",
   "format": "0.0%",
   "expr": "sum ( [{T}::NO_SHOW_FLAG] ) / sum ( [{T}::LINE_COUNT] )"
  },
  {
   "name": "Member Share",
   "desc": "Share of completed services delivered to members.",
   "format": "0.0%",
   "expr": "sum ( if ( [{T}::COMPLETED_FLAG] = 1 ) then [{T}::MEMBER_FLAG] else 0 ) / sum ( [{T}::COMPLETED_FLAG] )"
  },
  {
   "name": "Gross Margin %",
   "desc": "Gross margin as a share of net revenue.",
   "format": "0.0%",
   "expr": "sum ( [{T}::GROSS_MARGIN] ) / sum ( [{T}::NET_REVENUE] )"
  },
  {
   "name": "Average Ticket",
   "desc": "Net revenue per completed service line.",
   "format": "0.00",
   "expr": "sum ( [{T}::NET_REVENUE] ) / sum ( [{T}::COMPLETED_FLAG] )"
  },
  {
   "name": "Revenue per Chair Hour",
   "desc": "Net revenue per booked chair hour.",
   "format": "0.00",
   "expr": "sum ( [{T}::NET_REVENUE] ) / ( sum ( [{T}::APPOINTMENT_MINUTES] ) / 60 )"
  }
 ],
 "theme_parameter": true
}