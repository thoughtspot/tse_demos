  },
  {
   "name": "PROJECT_STATUS",
   "expr": "'Active' if r['_SEQ'] == (as_of.toordinal() + actor['_OFF']) // 180 else 'Completed'"
  },
  {
   "name": "PROJECT_PHASE",
   "expr": "'1. Kickoff' if r['PROJECT_DAY'] < 10 else ('2. Discovery' if r['PROJECT_DAY'] < 30 else ('3. Configuration' if r['PROJECT_DAY'] < 75 else ('4. Data Migration' if r['PROJECT_DAY'] < 110 else ('5. Testing & UAT' if r['PROJECT_DAY'] < 140 else ('6. Go-Live' if r['PROJECT_DAY'] < 155 else '7. Hypercare')))))"
  },
