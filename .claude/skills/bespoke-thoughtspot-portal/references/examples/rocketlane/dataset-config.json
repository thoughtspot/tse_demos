  {
   "name": "ASSIGNEE",
   "expr": "r['PROJECT_MANAGER'] if r['ASSIGNEE'] == '(PM)' else r['ASSIGNEE']"
  },
  {
   "name": "_DUE",
   "expr": "max(1, int(lognorm(6, 0.6)))"
  },
  {
   "name": "TASK_DUE_DATE",
   "expr": "d + timedelta(days=r['_DUE'])"
  },
  {
   "name": "_TAGE",
   "expr": "(as_of - d).days"
  },
  {
   "name": "TASK_STATUS",
   "expr": "weighted({'To Do': 60, 'In Progress': 36, 'Completed': 4}) if r['_TAGE'] <= 2 else (weighted({'To Do': 22, 'In Progress': 50, 'Completed': 24, 'Blocked': 4}) if r['_TAGE'] <= r['_DUE'] else (weighted({'Completed': 86, 'In Progress': 9, 'Blocked': 3, 'To Do': 2}) if r['_TAGE'] <= r['_DUE'] + 21 else (weighted({'Completed': 96, 'In Progress': 2.5, 'Blocked': 1.5}) if r['_TAGE'] <= 75 else 'Completed')))"
  },
  {
   "name": "_OVP",
   "expr": "0.06 + (0.05 if r['PROJECT_PHASE'] in ('4. Data Migration', '5. Testing & UAT') else 0) + (0.03 if r['SEGMENT'] == 'Enterprise' else 0) + ((0.30 * ramp(150)) if (r['SEGMENT'] == 'Enterprise' and r['PROJECT_PHASE'] in ('4. Data Migration', '5. Testing & UAT', '3. Configuration')) else 0)"
  },
  {
   "name": "IS_OVERDUE",
   "expr": "1 if (r['TASK_STATUS'] != 'Completed' and r['_TAGE'] > r['_DUE']) else (1 if chance(r['_OVP']) else 0)"
  },
  {
   "name": "DAYS_OVERDUE",
   "expr": "(r['_TAGE'] - r['_DUE']) if (r['IS_OVERDUE'] == 1 and r['TASK_STATUS'] != 'Completed') else (max(1, int(lognorm(4, 0.6) * (1.6 if r['SEGMENT'] == 'Enterprise' else 1))) if r['IS_OVERDUE'] == 1 else 0)"
  },
  {
   "name": "IS_AT_RISK",
   "expr": "1 if r['TASK_STATUS'] == 'Blocked' else (1 if (r['IS_OVERDUE'] == 1 and chance(0.45)) else (1 if chance(0.04 + r['_OVP'] * 0.5) else 0))"
  },
  {
   "name": "IS_COMPLETED",
   "expr": "1 if r['TASK_STATUS'] == 'Completed' else 0"
  },
  {
   "name": "IS_IN_PROGRESS",
   "expr": "1 if r['TASK_STATUS'] == 'In Progress' else 0"
  },
  {
   "name": "IS_TODO",
   "expr": "1 if r['TASK_STATUS'] == 'To Do' else 0"
  },
  {
   "name": "IS_BLOCKED",
   "expr": "1 if r['TASK_STATUS'] == 'Blocked' else 0"
  },
  {
   "name": "TASK_COUNT",
   "value": 1
  },
  {
   "name": "PLANNED_HOURS",
   "lognormal": {
    "by": "PROJECT_PHASE",
    "median": {
     "1. Kickoff": 1.5,
     "2. Discovery": 2.5,
     "3. Configuration": 3.0,
     "4. Data Migration": 3.5,
     "5. Testing & UAT": 2.5,
     "6. Go-Live": 2.0,
     "7. Hypercare": 1.5
    },
    "sigma": 0.5
   },
   "round": 1
  },
  {
   "name": "ACTUAL_HOURS",
   "expr": "r['PLANNED_HOURS'] * lognorm(1.04, 0.18) * (1.35 if r['IS_OVERDUE'] == 1 else 1) * (0 if r['TASK_STATUS'] == 'To Do' else (0.5 if r['TASK_STATUS'] in ('In Progress', 'Blocked') else 1))",
   "round": 1
  },
  {
   "name": "BILLABLE_HOURS",
   "expr": "0 if r['ASSIGNEE_ROLE'] == 'Customer' else r['ACTUAL_HOURS'] * (0.92 if r['BILLING_TYPE'] == 'Time & Materials' else (0.78 if r['BILLING_TYPE'] == 'Fixed Fee' else 0.65))",
   "round": 1
  },
  {
   "name": "COST_RATE",
   "map_from": "ASSIGNEE_ROLE",
   "map": {
    "Project Manager": [
     95
    ],
    "Implementation Consultant": [
     82
    ],
    "Solutions Architect": [
     118
    ],
    "Technical Consultant": [
     96
    ],
    "Data Migration Specialist": [
     102
    ],
    "QA Consultant": [
     70
    ],
    "Trainer": [
     64
    ],
    "Customer Success Manager": [
     76
    ],
    "Customer": [
     0
    ]
   }
  },
  {
   "name": "BUDGET_COST",
   "expr": "r['PLANNED_HOURS'] * r['COST_RATE']",
   "round": 2
  },
  {
   "name": "ACTUAL_COST",
   "expr": "r['ACTUAL_HOURS'] * r['COST_RATE']",
   "round": 2
  },
  {
   "name": "BILLED_REVENUE",
   "expr": "r['BILLABLE_HOURS'] * r['COST_RATE'] * 1.85",
   "round": 2
  },
  {
   "name": "PROJECT_PROGRESS_PCT",
   "expr": "min(100.0, max(1.0, (r['PROJECT_DAY'] + 4) / 1.75 * actor['_EFF'] * ((1 - 0.22 * ramp(150)) if r['SEGMENT'] == 'Enterprise' else 1)))",
   "round": 1
  },
  {
   "name": "TIME_TO_VALUE_DAYS",
   "expr": "{'Enterprise': 96, 'Mid-Market': 64, 'SMB': 41}[r['SEGMENT']] * actor['_EFF'] * lognorm(1.0, 0.06) * ((1 - 0.36 * ramp(200)) if r['PROJECT_MANAGER'] == 'Priya Raman' else 1)",
   "round": 1
  },
  {
   "name": "CSAT_SCORE",
   "expr": "(min(5.0, max(1.0, 4.45 - (0.9 if r['IS_OVERDUE'] == 1 else 0) + uniform(-0.5, 0.5)))) if r['TASK_TYPE'] == 'Customer Milestone' and r['TASK_STATUS'] == 'Completed' else None",
   "round": 1
  }
 ],
 "types": {
  "PLANNED_HOURS": "NUMBER(8,1)",
  "ACTUAL_HOURS": "NUMBER(8,1)",
  "BILLABLE_HOURS": "NUMBER(8,1)",
