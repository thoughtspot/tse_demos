{
 "name": "Rocketlane Project Analytics",
 "description": "Rocketlane PSA and customer onboarding: one row per project task with customer, segment, PM, delivery team, phase, assignee, status, overdue and at-risk flags, hours, budget vs actual cost, billed revenue, project progress, time to value and CSAT. Daily Oct 2024 to Oct 2026.",
 "table": "ROCKETLANE_TASKS",
