   ]
  },
  {
   "db": "TASK_STATUS",
   "name": "Task Status",
   "type": "ATTRIBUTE",
   "desc": "To Do, In Progress, Blocked, Completed.",
   "synonyms": [
    "status"
   ]
  },
  {
   "db": "IS_OVERDUE",
   "name": "Overdue Tasks",
   "type": "MEASURE",
   "desc": "Tasks completed late or open past their due date.",
   "synonyms": [
    "overdue",
    "late tasks"
   ],
   "agg": "SUM"
  },
  {
   "db": "DAYS_OVERDUE",
   "name": "Days Overdue",
   "type": "MEASURE",
   "desc": "Days past due.",
