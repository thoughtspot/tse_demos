   "desc": "Internal task, customer task, approval or customer milestone.",
   "synonyms": [
    "type"
   ]
  },
  {
   "db": "ASSIGNEE_ROLE",
   "name": "Assignee Role",
   "type": "ATTRIBUTE",
   "desc": "Role of the person the task is assigned to.",
   "synonyms": [
