   ]
  },
  {
   "db": "PROJECT_TYPE",
   "name": "Project Type",
   "type": "ATTRIBUTE",
   "desc": "Onboarding, Implementation, Integration Rollout, Expansion, Migration.",
   "synonyms": [
    "engagement type"
   ]
  },
  {
   "db": "PROJECT_NAME",
   "name": "Project Name",
   "type": "ATTRIBUTE",
   "desc": "Rocketlane project.",
   "synonyms": [
    "project",
    "engagement"
   ]
  },
  {
   "db": "PROJECT_ID",
   "name": "Project ID",
   "type": "ATTRIBUTE",
   "desc": "Project identifier.",
