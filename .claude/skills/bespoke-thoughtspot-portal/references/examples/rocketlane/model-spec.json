    "stuck tasks"
   ],
   "agg": "SUM"
  },
  {
   "db": "TASK_COUNT",
   "name": "Tasks",
   "type": "MEASURE",
   "desc": "Number of tasks.",
   "synonyms": [
    "tasks",
    "task count",
    "number of tasks"
   ],
   "agg": "SUM"
  },
  {
   "db": "PLANNED_HOURS",
   "name": "Planned Hours",
   "type": "MEASURE",
   "desc": "Estimated effort.",
   "synonyms": [
    "estimate",
    "budget hours"
   ],
   "agg": "SUM"
  },
  {
   "db": "ACTUAL_HOURS",
   "name": "Logged Hours",
   "type": "MEASURE",
   "desc": "Hours logged on timesheets.",
   "synonyms": [
    "actual hours",
    "time logged",
    "effort"
   ],
   "agg": "SUM"
  },
  {
   "db": "BILLABLE_HOURS",
   "name": "Billable Hours",
   "type": "MEASURE",
   "desc": "Billable hours logged.",
   "synonyms": [
    "billable time"
   ],
   "agg": "SUM"
  },
  {
   "db": "COST_RATE",
   "name": "Cost Rate",
   "type": "MEASURE",
   "desc": "Hourly cost rate of the assignee role.",
   "synonyms": [
    "hourly cost"
   ],
   "agg": "AVERAGE"
  },
  {
   "db": "BUDGET_COST",
   "name": "Budget Cost",
   "type": "MEASURE",
   "desc": "Planned cost (planned hours x cost rate).",
   "synonyms": [
    "budget",
    "planned cost"
   ],
   "agg": "SUM",
   "currency": true
  },
  {
   "db": "ACTUAL_COST",
   "name": "Project Cost",
   "type": "MEASURE",
   "desc": "Actual cost (logged hours x cost rate).",
   "synonyms": [
    "actual cost",
    "cost",
    "spend"
   ],
   "agg": "SUM",
   "currency": true
  },
  {
   "db": "BILLED_REVENUE",
   "name": "Billed Revenue",
   "type": "MEASURE",
   "desc": "Revenue billed for billable hours.",
   "synonyms": [
    "revenue",
    "billings"
   ],
   "agg": "SUM",
   "currency": true
  },
  {
   "db": "PROJECT_PROGRESS_PCT",
   "name": "Project Progress",
   "type": "MEASURE",
   "desc": "Project percent complete (0-100) when the task started.",
   "synonyms": [
    "progress",
    "percent complete",
    "completion"
   ],
   "agg": "AVERAGE"
  },
  {
   "db": "TIME_TO_VALUE_DAYS",
   "name": "Time to Value (days)",
   "type": "MEASURE",
   "desc": "Days from kickoff to the customer's first value (go-live).",
   "synonyms": [
    "ttv",
    "time to value",
    "time to go-live"
   ],
   "agg": "AVERAGE"
  },
  {
   "db": "CSAT_SCORE",
   "name": "CSAT",
   "type": "MEASURE",
   "desc": "Customer satisfaction (1-5) captured at customer milestones.",
   "synonyms": [
    "csat",
    "satisfaction",
    "customer satisfaction"
   ],
   "agg": "AVERAGE"
  }
 ],
 "theme_parameter": true,
 "formulas": [
  {
   "name": "Overdue Rate",
   "desc": "Overdue tasks / total tasks.",
   "format": "0.0%",
   "expr": "sum ( [{T}::IS_OVERDUE] ) / sum ( [{T}::TASK_COUNT] )"
  },
  {
   "name": "Completion Rate",
   "desc": "Completed tasks / total tasks.",
   "format": "0.0%",
   "expr": "sum ( [{T}::IS_COMPLETED] ) / sum ( [{T}::TASK_COUNT] )"
  },
  {
   "name": "At-Risk Rate",
   "desc": "Tasks at risk / total tasks.",
   "format": "0.0%",
   "expr": "sum ( [{T}::IS_AT_RISK] ) / sum ( [{T}::TASK_COUNT] )"
  },
  {
   "name": "Budget Variance %",
   "desc": "(Actual cost - budget) / budget.",
   "format": "0.0%",
   "expr": "( sum ( [{T}::ACTUAL_COST] ) - sum ( [{T}::BUDGET_COST] ) ) / sum ( [{T}::BUDGET_COST] )"
  },
  {
   "name": "Billable Utilization",
   "desc": "Billable hours / logged hours.",
   "format": "0.0%",
   "expr": "sum ( [{T}::BILLABLE_HOURS] ) / sum ( [{T}::ACTUAL_HOURS] )"
  },
  {
   "name": "Active Projects",
   "desc": "Unique projects.",
   "expr": "unique count ( [{T}::PROJECT_ID] )"
  }
 ]
}