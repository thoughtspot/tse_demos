    "risky tasks"
   ],
   "agg": "SUM"
  },
  {
   "db": "IS_COMPLETED",
   "name": "Completed Tasks",
   "type": "MEASURE",
   "desc": "Tasks completed.",
   "synonyms": [
    "done tasks",
    "closed tasks"
   ],
   "agg": "SUM"
  },
  {
   "db": "IS_IN_PROGRESS",
   "name": "In-progress Tasks",
   "type": "MEASURE",
   "desc": "Tasks in progress.",
   "synonyms": [
    "wip",
    "in progress"
   ],
   "agg": "SUM"
  },
  {
   "db": "IS_TODO",
   "name": "To-do Tasks",
   "type": "MEASURE",
   "desc": "Tasks not started.",
