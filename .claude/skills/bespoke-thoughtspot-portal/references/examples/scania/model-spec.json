 "formulas": [
  {
   "name": "Fuel per 100 km",
   "expr": "sum ( [{T}::FUEL_L] ) * 100 / sum ( if ( [{T}::FUEL_L] > 0 ) then [{T}::DISTANCE_KM] else 0 )",
   "desc": "Litres per 100 km on combustion vehicles.",
   "format": "#,##0.0",
   "synonyms": [
    "l/100km",
    "fuel consumption",
    "fuel efficiency"
   ]
  },
  {
   "name": "Energy per 100 km",
   "expr": "sum ( [{T}::ENERGY_KWH] ) * 100 / sum ( if ( [{T}::ENERGY_KWH] > 0 ) then [{T}::DISTANCE_KM] else 0 )",
   "desc": "kWh per 100 km on battery-electric vehicles.",
   "format": "#,##0.0"
  },
  {
   "name": "CO2 per km",
   "expr": "sum ( [{T}::CO2_KG] ) / sum ( [{T}::DISTANCE_KM] )",
   "desc": "Kilograms of CO2 per km driven.",
   "format": "#,##0.000"
  },
  {
   "name": "Idle Share",
   "expr": "sum ( [{T}::IDLE_HOURS] ) / sum ( [{T}::ENGINE_HOURS] )",
   "desc": "Share of engine time spent idling.",
   "format": "0.0%"
  },
  {
   "name": "Maintenance Adherence",
   "expr": "sum ( [{T}::SERVICE_ON_TIME] ) / sum ( [{T}::SERVICE_DUE] )",
   "desc": "Planned services completed on time.",
   "format": "0.0%"
  },
  {
   "name": "Unplanned Stops per 100k km",
   "expr": "sum ( [{T}::UNPLANNED_STOPS] ) * 100000 / sum ( [{T}::DISTANCE_KM] )",
   "desc": "Unplanned stops per 100,000 km.",
   "format": "#,##0.00"
  },
  {
   "name": "BEV Share",
   "expr": "sum ( if ( [{T}::POWERTRAIN] = 'Battery Electric' ) then 1 else 0 ) / sum ( [{T}::SHIFTS] )",
   "desc": "Share of shifts run by battery-electric vehicles.",
   "format": "0.0%"
  },
  {
   "name": "Harsh Brakes per 100 km",
   "expr": "sum ( [{T}::HARSH_BRAKES] ) * 100 / sum ( [{T}::DISTANCE_KM] )",
   "desc": "Harsh brake applications per 100 km.",
   "format": "#,##0.00"
  },
  {
   "name": "Active Vehicles",
   "expr": "unique count ( [{T}::VEHICLE_REG] )",
   "desc": "Distinct vehicles operating.",
   "format": "#,##0"
  },
  {
   "name": "Energy Cost",
   "expr": "sum ( [{T}::FUEL_L] ) * 1.62 + sum ( [{T}::ENERGY_KWH] ) * 0.26",
   "desc": "Estimated fuel and charging cost in EUR (EUR 1.62 per litre, EUR 0.26 per kWh).",
   "currency": "EUR"
  }
 ],
 "theme_parameter": true
}